# TaskWatch configuration. Copy to .env for local use.
# In production, inject these from a managed secrets store (work order: no credentials in source code or config files)
# instead of keeping a .env file on the server. Full list: docs/08-operations/ENVIRONMENT_CONFIGURATION.md
#
# [REQUIRED]       needed in every environment
# [PROD REQUIRED]  must be set in production (the server refuses to start, or a feature silently stays off)
# [OPTIONAL]       sensible default when left empty
#
# NODE_ENV is not set here: `npm start` reads server/production.env (tracked, NODE_ENV=production only) first.

# --- Core ---------------------------------------------------------------
# [PROD REQUIRED] Port for `npm start` (API + built web app on one port). `npm run dev` uses 4000 for the API
# (override with API_PORT) and 5173 for the web app.
PORT=4000
# [PROD REQUIRED] Where people open TaskWatch: links in alerts and emails, the Google redirect, the Secure cookie flag.
# Production: https://your-domain   ·   Local dev (Vite): http://localhost:5173   ·   npm start locally: http://localhost:4000
APP_URL=http://localhost:5173
# [REQUIRED] Postgres connection: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://localhost:5432/taskwatch
# [PROD REQUIRED] Long random string, e.g. `openssl rand -hex 32`. Production refuses to start without it;
# elsewhere a random value is used and sessions end on every restart.
SESSION_SECRET=
# [PROD REQUIRED] Where uploaded files are stored, relative to server/. In production: a persistent, backed-up volume.
UPLOAD_DIR=uploads

# --- Email via Google Workspace ----------------------------------------
# [PROD REQUIRED for live email] Without SMTP_HOST, SMTP_USER and SMTP_PASS, email is simulated: password-reset
# links and alerts are only written to the Delivery Log and the server log, never delivered.
# Automated email (escalations, reminders, digests) is sent for real only when NODE_ENV=production; a local server
# simulates it even with SMTP values set, so dev escalations never reach real inboxes. Emails a person sends by hand
# (onboarding, password reset) do go out locally. EMAIL_AUTOMATED_LOCALLY=true also sends automated email locally.
# EMAIL_AUTOMATED_LOCALLY=
# smtp.gmail.com:465 with a Workspace mailbox + app password, or smtp-relay.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# [OPTIONAL] Address shown as "TaskWatch <...>"; defaults to SMTP_USER
EMAIL_FROM_ADDRESS=

# --- Browser (Web Push) notifications (ADR-0012) -----------------------
# [OPTIONAL] Leave empty to simulate. Generate once: npx web-push generate-vapid-keys
# Keep the same pair forever: a new pair silently stops every browser that already enabled notifications.
# Needs HTTPS in production (localhost works in development).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [OPTIONAL] Contact for push services; defaults to mailto:EMAIL_FROM_ADDRESS
VAPID_SUBJECT=

# --- Google Workspace sign-in ------------------------------------------
# [OPTIONAL] Leave both empty to use email + password only.
# Google Cloud Console › APIs & Services › Credentials › OAuth client (Web application)
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated company domains allowed to sign in with Google
GOOGLE_ALLOWED_DOMAINS=bayareaimmigrationservices.com

# --- WhatsApp Business Cloud API ---------------------------------------
# [OPTIONAL] Switched off (decision D-106: email + in-app only). Nothing is queued for WhatsApp, whatever is set
# here; the code stays so it can be turned back on (WHATSAPP_ENABLED in shared/notifications.ts).
# Meta Business › WhatsApp › API Setup. Templates: docs/whatsapp-templates.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en

# --- Development only (refused or ignored when NODE_ENV=production) -----
# Directory sign-in ("pick a person") for local development. Off unless set to true. NEVER in production.
ALLOW_DEV_LOGIN=true
# Simulated-clock controls for demonstrating escalation (CoS only). Off unless set to true; never in production (D-47).
DEMO_TOOLS=true
# Real mailbox for the sample Chief of Staff (password-reset mail), used by db:seed. Default rahul@example.com.
# SEED_COS_EMAIL=
# API port for `npm run dev:server` (default 4000)
# API_PORT=4000
# Database the integration tests DROP and recreate. Default: DATABASE_URL's server with the name taskwatch_test.
# Never point it at real data, and never set it in production.
# TEST_DATABASE_URL=
# The web app's backend switch is NOT read from this file: Vite reads env files from client/ only.
# Use VITE_BACKEND=server on the command line or in client/.env (mock = in-browser sample data, the default on the
# dev server only). A production build (vite build) always uses the server, whatever this says.

# --- Optional tuning ------------------------------------------------------
# [OPTIONAL] Escalation engine interval in ms, 1000–300000 (WO FR-8: at least every 5 minutes). Default 60000.
# ENGINE_INTERVAL_MS=60000
# [OPTIONAL] Time zone of the nightly 02:00 audit-chain check (default America/Los_Angeles)
# NIGHTLY_TZ=America/Los_Angeles
