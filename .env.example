# TaskWatch configuration. Copy to .env for local use.
# In production, inject these from a managed secrets store (work order: no credentials
# in source code or config files) instead of keeping a .env file on the server.

# --- Core ---------------------------------------------------------------
# Port for `npm start` (API + built web app on one port). `npm run dev` always uses
# 4000 for the API (override with API_PORT) and 5173 for the web app.
PORT=4000
# Where people open TaskWatch; used for links in alerts and the Google redirect.
# Local dev (Vite): http://localhost:5173   ·   npm start (single server): http://localhost:4000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://localhost:5432/taskwatch
# Long random string, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=

# --- Google Workspace sign-in ------------------------------------------
# Google Cloud Console › APIs & Services › Credentials › OAuth client (Web application)
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated company domains allowed to sign in
GOOGLE_ALLOWED_DOMAINS=bayareaimmigrationservices.com

# --- WhatsApp Business Cloud API ---------------------------------------
# Switched off (decision D-106: email + in-app only). Nothing is queued for WhatsApp, whatever is set here;
# the code stays so it can be turned back on (WHATSAPP_ENABLED in shared/notifications.ts).
# Meta Business › WhatsApp › API Setup. Templates: docs/whatsapp-templates.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en

# --- Email via Google Workspace ----------------------------------------
# smtp.gmail.com:465 with a Workspace mailbox + app password, or smtp-relay.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address shown as "TaskWatch <...>"; defaults to SMTP_USER
EMAIL_FROM_ADDRESS=

# --- Development only (ignored when NODE_ENV=production) ----------------
# Directory sign-in ("pick a person") for local development. Off unless set to true.
ALLOW_DEV_LOGIN=true
# Simulated-clock controls for demonstrating escalation (true by default in dev)
DEMO_TOOLS=true
# Real mailbox for the sample Chief of Staff (password-reset mail), used by db:seed. Default rahul@example.com.
# SEED_COS_EMAIL=
# API port for `npm run dev:server` (default 4000)
# API_PORT=4000
# The web app's backend switch is NOT read from this file: Vite reads env files from client/ only.
# Use VITE_BACKEND=server on the command line or in client/.env (mock = in-browser sample data, the default).

# --- Optional tuning ------------------------------------------------------
# Escalation engine interval in ms, 1000–300000 (WO FR-8: at least every 5 minutes). Default 60000.
# ENGINE_INTERVAL_MS=60000
# Where uploaded files are stored, relative to server/ (default: uploads)
# UPLOAD_DIR=uploads
# Time zone of the nightly 02:00 audit-chain check (default America/Los_Angeles)
# NIGHTLY_TZ=America/Los_Angeles
